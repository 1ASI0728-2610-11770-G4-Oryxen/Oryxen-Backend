# ============================================================================
# Oryxen Backend — environment template
# Copy to `.env` for docker compose, or export as environment variables for the
# API process / Render. NEVER commit a real `.env` (it is git-ignored).
# ASP.NET Core maps double underscores to configuration sections:
#   ConnectionStrings__OryxenDb  ->  ConnectionStrings:OryxenDb
# ============================================================================

# ---- PostgreSQL (used by docker-compose.yml) -------------------------------
POSTGRES_DB=oryxen
POSTGRES_USER=oryxen
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
POSTGRES_PORT=5432

# ---- API: database connection ----------------------------------------------
# Local dev (API on host, DB in compose):
ConnectionStrings__OryxenDb=Host=localhost;Port=5432;Database=oryxen;Username=oryxen;Password=CHANGE_ME_LOCAL_DB_PASSWORD
# Render/managed Postgres needs SSL:
#ConnectionStrings__OryxenDb=Host=HOST;Port=5432;Database=DB;Username=USER;Password=PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# ---- JWT --------------------------------------------------------------------
Jwt__Issuer=OryxenAPI
Jwt__Audience=OryxenClients
Jwt__Secret=CHANGE_ME_USE_A_RANDOM_SECRET_OF_32_PLUS_CHARS
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=7

# ---- CORS (indexed array; add one entry per extra allowed frontend origin) ---
# The deployed frontends below are compiled into the allow-list, and the localhost
# origins are added automatically when ASPNETCORE_ENVIRONMENT=Development, so this
# section is only needed for origins the API does not already know about.
#Cors__AllowedOrigins__0=https://oryxen-web-application.vercel.app
#Cors__AllowedOrigins__1=https://oryxen-landing.web.app
#Cors__AllowedOrigins__2=https://oryxen-landing.firebaseapp.com

# ---- External services (leave empty to disable each integration) ------------
# Gemini (AI diagnosis + /ai/chat assistant): https://aistudio.google.com/apikey
GeminiVision__ApiKey=
# OpenWeatherMap (plant ambient weather): https://openweathermap.org/api
OpenWeatherMap__ApiKey=
# Stripe test mode (checkout + webhook): https://dashboard.stripe.com/test/apikeys
Stripe__SecretKey=
Stripe__WebhookSecret=
# SendGrid Mail Send (email alerts): https://app.sendgrid.com/settings/api_keys
SendGrid__ApiKey=
SendGrid__FromEmail=noreply@oryxen.io
SendGrid__FromName=Oryxen
# Firebase service account JSON (push adapter; requires device-token registration, see FirebaseFcmService)
FirebaseFcm__ServiceAccountJson=

# ---- IoT simulation worker ---------------------------------------------------
IoTSimulation__Enabled=false
IoTSimulation__IntervalMinutes=5
IoTSimulation__SeedDays=30

# ---- Swagger (force-enable outside Development for demos) --------------------
Swagger__Enabled=true
