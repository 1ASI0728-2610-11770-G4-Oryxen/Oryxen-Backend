# Copy this file to ".env" and adjust as needed before running `docker compose up -d`.
POSTGRES_DB=oryxen
POSTGRES_USER=oryxen
POSTGRES_PASSWORD=oryxen_dev_password
POSTGRES_PORT=5432

# Third-party integration: OpenWeatherMap. Get a free key at https://openweathermap.org/api
# The .NET configuration binder reads this via the "OpenWeatherMap:ApiKey" key
# (the double underscore maps the nested section when supplied as an environment variable).
OpenWeatherMap__ApiKey=
